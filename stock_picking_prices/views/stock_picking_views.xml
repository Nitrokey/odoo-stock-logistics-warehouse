<odoo>
    <!-- Add price fields to the stock.picking form view -->
    <record id="view_picking_form_inherit_prices" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.prices</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <!-- Add currency field (invisible) for monetary fields -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="currency_id" invisible="1" />
                <field name="sale_id" readonly="1" attrs="{'invisible': [('sale_id', '=', False)]}" />
            </xpath>
            
            <!-- Add price fields to the move lines -->
            <xpath expr="//field[@name='move_ids_without_package']/tree" position="inside">
                <field name="currency_id" invisible="1" />
                <field name="sale_line_id" invisible="1" />
                <field name="price_unit" attrs="{'column_invisible': [('parent.sale_id', '=', False)]}" optional="show" />
                <field name="price_subtotal" widget="monetary" options="{'currency_field': 'currency_id'}" 
                       attrs="{'column_invisible': [('parent.sale_id', '=', False)]}" optional="show" />
            </xpath>
            
            <!-- Add total amount at the bottom of the form -->
            <xpath expr="//notebook" position="after">
                <group class="oe_subtotal_footer">
                    <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}" 
                           attrs="{'invisible': [('sale_id', '=', False)]}" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
